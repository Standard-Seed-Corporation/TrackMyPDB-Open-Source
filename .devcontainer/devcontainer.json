{
  "name": "TrackMyPDB",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "streamlit_app.py"] },
    "vscode": { "extensions": ["ms-python.python", "ms-python.vscode-pylance"] }
  },
  "updateContentCommand": "sudo apt-get update && xargs sudo apt-get install -y < packages.txt && pip install --user -e '.[app,agent,test]'",
  "postAttachCommand": { "server": "streamlit run streamlit_app.py" },
  "portsAttributes": { "8501": { "label": "TrackMyPDB", "onAutoForward": "openPreview" } },
  "forwardPorts": [8501]
}
