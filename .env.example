# Copy to ".env" (never commit the real file). Loaded automatically by the app.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: any model your Anthropic account can access.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to 1 ONLY on a private deployment to let every visitor use the key above.
TRACKMYPDB_ALLOW_SHARED_KEY=0
