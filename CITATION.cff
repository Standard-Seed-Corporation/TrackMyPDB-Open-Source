cff-version: 1.2.0
message: "If you use TrackMyPDB, please cite it using the metadata below."
title: "TrackMyPDB"
abstract: >-
  Extract ligands from the PDB structures of UniProt proteins and rank them by
  fingerprint similarity to query molecules; available as a Python library,
  command-line tool, Streamlit web app and MCP server.
type: software
version: 2.1.0
date-released: 2026-11-23  # TODO: set when the v2.1.0 release is tagged
license: MIT
url: "https://trackmypdbsscai.streamlit.app/"
# repository-code: "https://github.com/<org>/TrackMyPDB-Open-Source"  # TODO
